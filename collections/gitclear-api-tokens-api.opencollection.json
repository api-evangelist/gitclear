{
  "opencollection": "1.0.0",
  "info": {
    "name": "GitClear Public API Tokens API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Validate the current API token status.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.gitclear.com/api/v1/api_tokens"
          },
          "docs": "Validate the current API token status."
        }
      ]
    }
  ],
  "bundled": true
}